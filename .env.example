# TASALO Miniapp - Environment Configuration
# Copiar a .env y completar valores

# Flask
FLASK_SECRET_KEY=tu_clave_secreta_aqui
FLASK_ENV=production  # development o production
PORT=5040

# Backend API URL (la usa el servidor; el navegador solo habla con este mismo origen)
# Desarrollo: http://localhost:8040
# Producción: https://tasalo.duckdns.org
TASALO_API_URL=http://localhost:8040

# --- Telegram (identidad del usuario) ---
# Token del bot: el servidor valida con él el initData que manda Telegram. Solo en este .env, nunca en el cliente.
TELEGRAM_BOT_TOKEN=
# Usuario del bot, sin @ (enlace de la pantalla "Ábrela desde @...")
BOT_USERNAME=tasalobot
# IDs de Telegram con acceso al panel admin, separados por comas (vacío = nadie)
ADMIN_CHAT_IDS=
# Edad máxima del initData en segundos (86400 = 24 h)
INITDATA_MAX_AGE=86400
# Prefijo bajo el que se publica la app. La app acepta las rutas con y sin prefijo.
# Producción detrás de Caddy: /miniapp   |   Desarrollo local: vacío
TASALO_BASE_PATH=

# --- Clave admin de taso-api ---
# Misma clave que ADMIN_API_KEY de taso-api/taso-bot. Nombre nuevo: TASALO_ADMIN_KEY.
TASALO_ADMIN_KEY=
# OBSOLETA: se acepta durante una versión con aviso; usa TASALO_ADMIN_KEY
ADMIN_API_KEY=

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# --- Notas ---
# FLASK_SECRET_KEY: generar con secrets.token_hex(32) en Python
# TASALO_API_URL: URL de taso-api sin barra final
# TELEGRAM_BOT_TOKEN: sin él, /api/me responde 503 y nadie puede entrar (a propósito)
# PORT: puerto para gunicorn (por defecto 5040)

# --- Mercado /p y alertas de precio cripto (S10) ---
# Mismas claves que el .env de taso-bot; cada una admite varias separadas por coma (rotacion).
GROQ_API_KEY=
COINMARKETCAP_API_KEY=
# Pool de CMC dedicado a las alertas (vacio = usa COINMARKETCAP_API_KEY)
CMC_API_KEY_ALERTA=
COINGECKO_API_KEY=
# Binance: primero la de EE. UU. y, si falla o no tiene el par, la global de respaldo (como el bot)
BINANCE_BASE_URL=https://api.binance.us
BINANCE_FALLBACK_URL=https://api.binance.com
# SQLite propia de la app (relativa a la raiz del proyecto; data/ esta en .gitignore)
DB_PATH=data/taso-app.db
# Revision de alertas de precio en segundos (300 = 5 min; 0 = desactivada)
PRICE_CHECK_INTERVAL_SECONDS=300